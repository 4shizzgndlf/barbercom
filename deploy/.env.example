# Copy this file to deploy/.env on the Azure VM. Never commit deploy/.env.
MYSQL_DATABASE=barbercomdb
MYSQL_USER=barberuser
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# The VM's public URL, for example http://20.54.12.34
BARBERCOM_PUBLIC_URL=http://YOUR_VM_PUBLIC_IP

# Brevo e-mail and SMS
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=YOUR_BREVO_SMTP_LOGIN
SPRING_MAIL_PASSWORD=YOUR_BREVO_SMTP_KEY
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS=true
BARBERCOM_MAIL_FROM=YOUR_VERIFIED_SENDER_EMAIL
BREVO_API_KEY=YOUR_BREVO_API_KEY
BARBERCOM_SMS_SENDER=BarberCom

# Stripe (use live keys only when you are ready to take real payments)
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
BARBERCOM_BUSINESS_SUBSCRIPTION_PRICE_ID=YOUR_STRIPE_PRICE_ID
